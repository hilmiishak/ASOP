# Database Configuration (PostgreSQL in Docker or Supabase/Neon, falls back to SQLite locally if omitted)
DATABASE_URL=postgresql://asop_user:asop_password@localhost:5432/asop_db

# Google Gemini AI (Free tier key from https://aistudio.google.com/app/apikey)
# Optional: ASOP includes a built-in hybrid AI fallback if GEMINI_API_KEY is left blank
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
